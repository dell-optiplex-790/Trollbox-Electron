{
  "name": "trollbox-electron",
  "version": "1.0.0",
  "description": "Desktop Trollbox client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install": "npm i webpack webpack-cli terser electron -g && npm run start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:cache": "webpack -c webpack.config-ui.js && webpack -c webpack.config-node.js && webpack -c webpack.config-node_preload.js",
    "build:pack": "node helpers/zipitup.js",
    "build": "npm run build:cache && npm run build:pack"
  },
