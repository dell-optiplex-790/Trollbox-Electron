    "@types/socket.io-client": "^1.4.36",
    "baseline-browser-mapping": "^2.9.18",
    "copy-webpack-plugin": "^13.0.1",
    "electron": "^38.2.2",
    "jszip": "^3.10.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1"
  },
  "type": "commonjs",
  "dependencies": {
    "bufferutil": "^4.1.0",
    "dompurify": "^3.2.7",
    "he": "^1.2.0",
    "luxon": "^3.7.2",
    "socket.io-client": "^2.2.0",
